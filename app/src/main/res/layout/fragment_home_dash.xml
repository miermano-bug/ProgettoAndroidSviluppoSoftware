<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════ SALUTO + STATUS ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_greeting"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/textSaluto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ciao, Tecnico 👋"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/textStatusLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Caricamento interventi…"
                android:textSize="14sp"
                android:textColor="#C8E6C9" />

        </LinearLayout>

        <!-- margine negativo per sovrapporre la card sul gradiente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="-20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ══════ CARD PROSSIMO INTERVENTO ══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProssimoIntervento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_next_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Prossimo intervento"
                            android:textSize="13sp"
                            android:textColor="#A5D6A7"
                            android:letterSpacing="0.06" />
                        <TextView
                            android:id="@+id/textProssimoStato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1B5E20"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="IN_CORSO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#A5D6A7"
                            android:letterSpacing="0.04" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textProssimoTicket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ticket #—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/textProssimoNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="13sp"
                        android:textColor="#C8E6C9"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginBottom="14dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1B5E20"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📅 Data inizio"
                                android:textSize="11sp"
                                android:textColor="#A5D6A7" />
                            <TextView
                                android:id="@+id/textProssimoData"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="—"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥 Team"
                                android:textSize="11sp"
                                android:textColor="#A5D6A7" />
                            <TextView
                                android:id="@+id/textProssimoTeam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="—"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nessun intervento in programma -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNessunIntervento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅" android:textSize="40sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nessun intervento in programma"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A2E1A"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ottimo lavoro! Sei aggiornato."
                        android:textSize="13sp"
                        android:textColor="#4E6B4E"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════ RIEPILOGO RAPIDO ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIEPILOGO RAPIDO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Completati -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_summary_card"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/textRiepilogoCompletati"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✓ Completati"
                        android:textSize="12sp"
                        android:textColor="#4E6B4E" />
                </LinearLayout>

                <!-- Mancanti -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_summary_card"
                    android:padding="16dp"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:id="@+id/textRiepilogoMancanti"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#E65100"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="⧗ Mancanti"
                        android:textSize="12sp"
                        android:textColor="#4E6B4E" />
                </LinearLayout>
            </LinearLayout>

            <!-- In corso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_summary_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/textRiepilogoInCorso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="— in corso"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                    <TextView
                        android:id="@+id/textRiepilogoTotale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— totali"
                        android:textSize="13sp"
                        android:textColor="#4E6B4E" />
                </LinearLayout>
            </LinearLayout>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBarHome"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#2E7D32"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
