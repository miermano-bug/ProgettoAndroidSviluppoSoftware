<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════ HEADER blu arrotondato con saluto (stesso stile del tecnico) ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_greeting_section"
            android:elevation="6dp"
            android:paddingBottom="24dp">

            <View android:layout_width="match_parent" android:layout_height="20dp" />

            <!-- Riga logout, allineata a destra -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_logout_button"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_pulsante_logout">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_logout"
                        android:importantForAccessibility="no"
                        app:tint="@color/error" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Esci"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:importantForAccessibility="no"
                        android:textColor="@color/error" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textSaluto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Benvenuto!"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rendi la tua città un posto migliore"
                android:textColor="#E0F2F1"
                android:textSize="14sp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <!-- Corpo principale contenente le opzioni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleziona un'operazione"
                android:textStyle="bold"
                android:textColor="#455A64"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="16dp"/>

            <!-- CARD: LE MIE NOTIFICHE (la card "Nuova segnalazione" è stata rimossa:
                 la stessa azione è ora raggiungibile solo dal FAB "+" nel container,
                 per evitare due punti di accesso ridondanti alla stessa funzione) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNotifiche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="#E65100"
                        android:background="#FFF3E0"
                        android:padding="8dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Le mie notifiche"
                            android:textStyle="bold"
                            android:textColor="#263238"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rimani aggiornato sulle novità comunali"
                            android:textColor="#78909C"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>