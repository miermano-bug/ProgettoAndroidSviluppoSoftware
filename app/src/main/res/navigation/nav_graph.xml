<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.auth.LoginFragment"
        android:label="Login" />

    <fragment
        android:id="@+id/citizenHomeFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.cittadino.CitizenHomeFragment"
        android:label="Citizen Home">

        <action
            android:id="@+id/action_citizenHome_to_nuovaSegnalazione"
            app:destination="@id/nuovaSegnalazioneFragment"/>

        <action
            android:id="@+id/action_citizenHome_to_mieSegnalazioni"
            app:destination="@id/leMieSegnalazioniFragment"/>

    </fragment>

    <fragment
        android:id="@+id/nuovaSegnalazioneFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.cittadino.NuovaSegnalazioneFragment"
        android:label="Nuova Segnalazione"/>

    <fragment
        android:id="@+id/leMieSegnalazioniFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.cittadino.LeMieSegnalazioniFragment"
        android:label="Le mie segnalazioni"/>

    <fragment
        android:id="@+id/technicianHomeFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.tecnico.TecnicoContainerFragment"
        android:label="Technician Home" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.auth.RegisterFragment"
        android:label="Register" />

    <!--
        Destinazione Impostazioni: PreferenceFragmentCompat con la schermata
        preferences_tecnico.xml. Raggiungibile dal bottone impostazioni in HomeTabFragment.
        Il back stack viene gestito automaticamente dal Navigation Component.
    -->
    <fragment
        android:id="@+id/impostazioniFragment"
        android:name="it.unisannio.soscity.soscity_app.ui.tecnico.ImpostazioniFragment"
        android:label="@string/impostazioni_titolo" />

</navigation>